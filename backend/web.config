<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service uses IIS + iisnode to host Node.js apps.
  This web.config tells IIS to forward all requests to server.js via iisnode.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <!-- Health check -->
        <rule name="health" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="server.js" />
        </rule>
        <!-- All API traffic -->
        <rule name="api" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode watchedFiles="web.config;*.js" />
  </system.webServer>
</configuration>
